# Copy this file to .env for local development. Keep .env out of version control.
# --- Shared infrastructure ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379

KAFKA_BROKERS=localhost:9092

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

NODE_ENV=development

# Service behavior
PAYMENT_SUCCESS_RATE=0.9
LOCATION_TTL_SECONDS=300

# Local service overrides, when running one service outside Docker:
# SERVICE_NAME=auth-service
# PORT=3001
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_service
# USER_SERVICE_URL=http://localhost:3002
# ORDER_SERVICE_URL=http://localhost:3006
# DRIVER_SERVICE_URL=http://localhost:3009
# DELIVERY_SERVICE_URL=http://localhost:3008
